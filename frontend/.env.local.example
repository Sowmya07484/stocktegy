# Sample-data mode (default). The UI generates SAMPLE results in the browser and never calls FastAPI.
# Set to false once the backend endpoints pass their tests.
NEXT_PUBLIC_USE_SAMPLE_DATA=true

# Where the Next.js dev server proxies /api/* (server-side, no CORS needed).
# 127.0.0.1 rather than localhost: Node may resolve localhost to ::1, which uvicorn does not listen on by default.
BACKEND_URL=http://127.0.0.1:8000

# Optional: call FastAPI directly from the browser instead of via the proxy.
# Requires CORSMiddleware on the backend allowing http://localhost:3000.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
