# FastAPI backend. /api/* requests from the browser are forwarded here by next.config.ts.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Sample-data mode (default true): results are generated in the browser and FastAPI is NOT called.
# Set to false when integration begins so the dashboard shows real API responses.
NEXT_PUBLIC_USE_SAMPLE_DATA=true
